# ============================================================================
# Env vars shared by tools/deal-agent.js, tools/price-agent.js,
# tools/monthly-report.js, and tools/run-deal-agent.sh/run-price-agent.sh
# (same var names, one file).
# Copy this to tools/.env.deal-agent (gitignored) on the SERVER MACHINE and
# fill in real values. NEVER commit the real file - it holds the Supabase
# service_role key, which bypasses RLS entirely.
# ============================================================================
SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
SUPABASE_SERVICE_ROLE_KEY=sb_secret_YOUR_KEY_HERE

SEARXNG_URL=http://localhost:8080

# Gemma runs on this same server machine - talk to it over localhost, not
# Tailscale or a tunnel (see the privacy discussion: this keeps everything
# on one box, no new device on any network).
GEMMA_ENDPOINT=http://localhost:11434/api/generate
# Exact tag from `ollama list` on the server machine - fill this in for real,
# "gemma3:4b" here is a placeholder guess, not a confirmed value.
GEMMA_MODEL=gemma3:4b
