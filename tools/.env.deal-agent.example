# ============================================================================
# Env vars shared by tools/deal-agent.js, tools/price-agent.js,
# tools/embed-expenses.js, tools/monthly-report.js, and tools/run-deal-
# agent.sh/run-price-agent.sh/run-embed-expenses.sh (same var names, one file).
# Copy this to tools/.env.deal-agent (gitignored) on the SERVER MACHINE and
# fill in real values. NEVER commit the real file - it holds the Supabase
# service_role key, which bypasses RLS entirely.
# ============================================================================
SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
SUPABASE_SERVICE_ROLE_KEY=sb_secret_YOUR_KEY_HERE

# deal-agent.js and price-agent.js only - both search/extract public data
# (subscription pricing pages, stock/index prices), not local Gemma/
# SearXNG. Two separate free, no-card services, not one: Tavily does the
# real live web search, Gemini (plain generation, no search tool) does the
# extraction from Tavily's real results. This split exists because
# Gemini's own Google Search grounding tool was tried first and found
# (live, this session) to require a billing account linked to the project
# to get ANY quota - even the portion Google's docs describe as a free
# monthly allowance - which conflicts with this project's $0/no-card rule.

# Get a free key at https://tavily.com - sign up with email or Google/
# GitHub OAuth, no credit card required. Free tier is 1,000 search
# credits/month as of this writing.
TAVILY_API_KEY=YOUR_TAVILY_API_KEY_HERE

# Get a free key at https://aistudio.google.com/apikey - create it with NO
# billing account attached, so a call to a model that needs billing just
# fails cleanly rather than being able to charge anything. Confirmed live
# this session: plain (non-grounded) generation works fine on a no-billing
# key - only the search-grounding tool is blocked without billing, and
# this script no longer uses that tool at all.
GEMINI_API_KEY=YOUR_GEMINI_API_KEY_HERE
# Optional override. gemini-flash-latest is the default - a stable rotating
# alias, chosen deliberately over a hardcoded version number after
# gemini-2.5-flash (this file's original default) was found live-deprecated
# for new API keys within days of being set as the default. Override to pin
# a specific version if you want that instead.
GEMINI_MODEL=gemini-flash-latest

# price-agent.js only - real stock-ticker price lookups (a user's own
# asset watchlist, MARKET_MOVERS_WATCHLIST). A plain GET returning the
# price directly as JSON, no search or LLM extraction needed at all for
# this half of price-agent.js's work - MARKET_INDEXES still uses Tavily+
# Gemini above (Finnhub's free-tier index access is unconfirmed, so
# indexes stay on the already-verified pipeline rather than risk it).
# Get a free key at https://finnhub.io/register - email signup, no credit
# card. Free tier is 60 calls/minute, real-time US stock quotes.
FINNHUB_API_KEY=YOUR_FINNHUB_API_KEY_HERE

# Gemma runs on this same server machine - talk to it over localhost, not
# Tailscale or a tunnel (see the privacy discussion: this keeps everything
# on one box, no new device on any network). Only embed-expenses.js and
# monthly-report.js use this - both touch real personal expense data, which
# must never route through a cloud LLM like Gemini above.
GEMMA_ENDPOINT=http://localhost:11434/api/generate
# Exact tag from `ollama list` on the server machine - fill this in for real,
# "gemma3:4b" here is a placeholder guess, not a confirmed value.
GEMMA_MODEL=gemma3:4b
# Optional - only tools/embed-expenses.js reads this. Defaults to
# nomic-embed-text (confirmed via a real /api/embeddings call to return
# 768-dim vectors - see supabase/45_expense_embeddings.sql). Override only
# if the server machine has a different embedding model pulled; changing
# this after embeddings already exist means re-embedding everything, since
# a different model's vectors aren't comparable to the old ones.
GEMMA_EMBED_MODEL=nomic-embed-text
